# AK Engine Provider Configuration
# Copy this file to .env and add your own keys.
# NEVER commit .env.

# Google Gemini
GEMINI_API_KEY=

# Groq
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Future providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b-cloud
